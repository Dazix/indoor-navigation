{
  "name": "indoor-navigation",
  "private": true,
  "version": "1.0.0",
  "description": "Zero-backend indoor navigation PWA with markerless visual localization (TensorFlow.js MobileNet), QR fallback, AR compass and pedestrian dead reckoning.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host --mode lan",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host --mode lan",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-pwa-assets": "pwa-assets-generator",
    "fetch-model": "node scripts/fetch-model.mjs"
  },
  "dependencies": {
    "@tensorflow-models/mobilenet": "2.1.1",
    "@tensorflow/tfjs": "4.22.0",
    "idb-keyval": "6.3.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.48.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "workbox-window": "7.4.1"
  }
}
